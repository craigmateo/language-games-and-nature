journal = {Proceedings of the National Academy of Sciences of the United States of America},
number = {8},
pages = {4398--4403},
title = {{Navigation-related structural change in the hippocampi of taxi drivers}},
volume = {97},
year = {2000}
}
@article{Turanli2005a,
abstract = {Perspicuous representation, Wittgenstein offers, is not another methodology, but it consists in seeing the connections. The Wittgensteinian perspicuous representation is therapeutic. The method he suggests for philosophy is the same method he suggests for social sciences. In both of these cases, he tries to get us to see the confusions we become entangled in when philosophizing and theorizing. In both of these disciplines he warns us not to advance explanatory, metaphysical theories. In this paper, I connect this concern with Wittgenstein's critique of Frazer. In criticizing Frazer, Wittgenstein adopts the important part of Spengler's view. Nonetheless, there are differences between Wittgenstein's views and those of Spengler; this paper aims to show similarities as well as these differences. The first part of the paper briefly summarizes Frazer's views. The second part focuses on Wittgenstein's critique of Frazer concerning science and technology. The third part gives an account of his critique regarding method of social sciences and philosophy. The last part concentrates on Wittgenstein's critique of Frazer pertaining to the tolerance towards alternative forms of life.},
author = {Turanli, Aydan},
doi = {10.1177/0191453705048320},
file = {:C$\backslash$:/Users/Craig/AppData/Local/Mendeley Ltd./Mendeley Desktop/Downloaded/Turanli - 2005 - Wittgenstein and Spengler vis-{\`{a}}-vis Frazer.pdf:pdf},
issn = {01914537},
journal = {Philosophy {\&} Social Criticism},
keywords = {an engineering-,anthropologist or sociologist but,context-free vacuum,evolutionary explanation,incommensurability,methodology of social sciences,perspicuous,representation,science,technology,tolerance,totem and taboo,wittgenstein is not an},
number = {1},
pages = {69 --88},
title = {{Wittgenstein and Spengler vis-{\`{a}}-vis Frazer}},
url = {http://psc.sagepub.com/content/31/1/69.abstract},
volume = {31},
year = {2005}
}
