@article{Hammer1978,
abstract = {The present study investigated some of the major dimensions of intercultural effectiveness. Based upon a review of the literature, 24 ``abilities'' thought to be important for intercultural effectiveness were generated. Fifty-three subjects who had reported functioning effectively in other cultures rated these abilities in terms of their importance in facilitating intercultural effectiveness. Factor analysis of the data yielded three dimensions of intercultural effectiveness: (1) the ability to deal with psychological stress; (2) the ability to communicate effectively; and (3) the ability to establish interpersonal relationships. Results of the study were then related to previous work on intercultural effectiveness. Resumen Se investigaron algunas de las principales dimensiones de la eficacia intercultural. Se generaron 24 ``habilidades'' que se estima son importantes para la eficacia de la acci{\'{o}}n intercultural, basada en un repaso de la literatura. A 54 sujetos que hab{\'{i}}an manifestado haber actuado en forma efic{\'{a}}z en otras culturas se le pidi{\'{o}} que clasificasen a dichas habilidades en terminos de su importancia para facilitar la eficacia intercultural. Un an{\'{a}}lisis factorial di{\'{o}} como resultado la existencia de tres dimensiones de eficacia intercultural: (1) la habilidad para poder resistir el stress psicol{\'{o}}gico; (2) la habilidad para comunicarse con facilidad; y (3) la habilidad para establecer relaciones interpersonales. Los resultados de este estudio fueron luego relacionados a trabajos previos sobre eficacia intercultural. R{\'{e}}sum{\'{e}} La pr{\'{e}}sente {\'{e}}tude se proposait d'explorer quelques-unes des principales dimensions de la comp{\'{e}}tence interculturelle. A partir d'une revue de litt{\'{e}}rature, il a {\'{e}}t{\'{e}} possible d'isoler 24 ``habilet{\'{e}}s'' jug{\'{e}}es importantes pour la comp{\'{e}}tence interculturelle. Cinquante trois sujets qui disaient fonctionner efficacement dans d'autres cultures ont cot{\'{e}} ces habilet{\'{e}}s d'apr{\`{e}}s leur importance dans la facilitation de la comp{\'{e}}tence interculturelle. Une analyse factorielle des donn{\'{e}}es a fait ressortir trois dimensions de la comp{\'{e}}tence interculturelle: (1) l'habilet{\'{e}} {\`{a}} s'accomoder au stress psychologique; (2) l'habilet{\'{e}} {\`{a}} communiquer efficacement; et (3) l'habilet{\'{e}} {\`{a}} {\'{e}}tablir des relations interpersonnelles. Les r{\'{e}}sultats de cette {\'{e}}tude furent ensuite discut{\'{e}}s en relation avec les travaux ant{\'{e}}rieurs sur la comp{\'{e}}tence interculturelle.},
author = {Hammer, Mitchell R. and Gudykunst, William B. and Wiseman, Richard L.},
doi = {https://doi.org/10.1016/0147-1767(78)90036-6},
issn = {0147-1767},
journal = {International Journal of Intercultural Relations},
number = {4},
pages = {382--393},
title = {{Dimensions of intercultural effectiveness: An exploratory study}},
url = {http://www.sciencedirect.com/science/article/pii/0147176778900366},
volume = {2},
year = {1978}
}
