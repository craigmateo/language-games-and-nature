@article{Kottak1999a,
abstract = {Older ecologies have been remiss in the narrowness of their spatial and temporal honzons, their functionalist assumptions, and their apolitical character. Suspending functionalist assumptions and an emphasis upon (homeo)stasis, "the new eco- logical anthropology" is located at the intersection of global, national, regional, and local systems, studying the outcome of the interaction of multiple levels and multiple factors. It blends theoretical and empineal research with applied, policy-di- rected, and critical work in what Rappaport called an "engaged" anthropology; and it is otherwise attuned to the political aspects and implications of ecological processes. Carefully laying out a critique of previous ecologies by way of announc- ing newer approaches, the article insists on the need to recognize the importance of culture mediations in ecological proc- esses rather than treating culture as epiphenomenal and as a mere adaptive tool. It closes with a discussion of the methodologies appropriate to the new ecological anthropolog},
