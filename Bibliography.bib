pages = {31},
title = {{Analysing Culture and Interculture in Saudi EFL Textbooks: A Corpus Linguistic Approach}},
url = {http://www.ccsenet.org/journal/index.php/elt/article/view/72851},
volume = {11},
year = {2018}
}
